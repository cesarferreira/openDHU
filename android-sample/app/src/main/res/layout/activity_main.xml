<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F2F6F7" android:fillViewport="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="32sp" android:textStyle="bold"
            android:textColor="#12383C" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/phone_intro" android:textSize="17sp" android:layout_marginTop="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:background="@drawable/favorite_card"
            android:layout_marginTop="32dp" android:layout_marginBottom="32dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/favorite_label" android:textSize="12sp" android:textColor="#007D82" />
            <TextView android:id="@+id/favorite" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
                android:textColor="#12383C" android:layout_marginTop="8dp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/choose_place" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/place_choices" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
        <Button android:id="@+id/reset" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/reset_favorite" android:textAllCaps="false" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/phone_help" android:textSize="15sp" android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
